rules_version = '2';

// Reglas de seguridad de la base de datos de Tech Marea.
// Se publican con:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    // Es admin si su UID está cargado en la colección "admins" (se carga a mano desde la consola)
    function esAdmin() {
      return estaLogueado()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lista de administradores: cada uno solo puede ver su propia ficha; nadie puede modificarla desde la web
    match /admins/{uid} {
      allow read: if estaLogueado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Técnicos (ej: tu colega): pueden usar el cotizador, nada más. Se cargan a mano desde la consola
    function esTecnico() {
      return estaLogueado()
        && exists(/databases/$(database)/documents/tecnicos/$(request.auth.uid));
    }
    match /tecnicos/{uid} {
      allow read: if estaLogueado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Ajustes del cotizador (ganancia y mano de obra): los ve el equipo, los cambia solo el admin
    match /config/{id} {
      allow read: if esAdmin() || esTecnico();
      allow write: if esAdmin();
    }

    // Reparaciones: cualquiera puede consultar UNA orden si conoce el número,
    // pero solo el admin puede ver la lista completa, crear, editar o borrar.
    match /reparaciones/{orden} {
      allow get: if true;
      allow list, create, update, delete: if esAdmin();
    }

    // Stock de cada producto (el ID es el del catálogo): todos lo pueden ver para
    // ocultar lo agotado; solo el admin lo modifica (el servidor lo descuenta solo al vender)
    match /stock/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Ventas pagadas con Mercado Pago: las anota el servidor; el admin las ve y marca entregadas
    match /ventas/{id} {
      allow read: if esAdmin();
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["entregado"]);
      allow create, delete: if false;
    }

    // Carrito de cada cliente: solo lo ve y lo modifica su dueño
    match /carritos/{uid} {
      allow read, write: if estaLogueado() && request.auth.uid == uid;
    }

    // Datos de cada cliente: solo los ve y los modifica su dueño
    match /usuarios/{uid} {
      allow read, write: if estaLogueado() && request.auth.uid == uid;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
